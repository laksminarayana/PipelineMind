# Optional Groq LLM credentials. Leave empty to use local simulation.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional Hindsight server credentials. Without an available SDK/server,
# the application uses its clearly labeled local SQLite demo memory engine.
HINDSIGHT_API_URL=http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=pipelinemind-devops

# Change this before exposing Grafana beyond a local development machine.
GRAFANA_ADMIN_PASSWORD=admin

PORT=8000
